        {
          "type": "frame",
          "id": "8Ihc9",
          "name": "codeEditor",
          "width": "fill_container",
          "height": "fill_container",
          "layout": "vertical",
          "gap": 2,
          "padding": [
            16,
            20
          ],
          "children": [
            {
              "type": "text",
              "id": "qfahG",
              "name": "ce_line1",
              "fill": "#F472B6",
              "content": "server {",
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "YHVWe",
              "name": "ce_line2",
              "fill": "#E4E4E7",
              "content": "    listen 80;",
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "0XH6Z",
              "name": "ce_line3",
              "fill": "#E4E4E7",
              "content": "    server_name example.com;",
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "Z33Hy",
              "name": "ce_line4",
              "fill": "#E4E4E7",
              "content": "    root /www/wwwroot/example.com;",
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "5I0vf",
              "name": "ce_line5",
              "fill": "#E4E4E7",
              "content": "    index index.php index.html;",
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "IMVwf",
              "name": "ce_line6",
              "fill": "#E4E4E7",
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "DRDOs",
              "name": "ce_line7",
              "fill": "#60A5FA",
              "content": "    location / {",
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "gzQiG",
              "name": "ce_line8",
              "fill": "#E4E4E7",
              "content": "        try_files $uri $uri/ /index.php?$query_string;",
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "iBUnB",
              "name": "ce_line9",
              "fill": "#60A5FA",
              "content": "    }",
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "OQOLh",
              "name": "ce_line10",
              "fill": "#E4E4E7",
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "v4PCD",
              "name": "ce_line11",
              "fill": "#60A5FA",
              "content": "    location ~ \\.php$ {",
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "ztqjS",
              "name": "ce_line12",
              "fill": "#E4E4E7",
              "content": "        fastcgi_pass 127.0.0.1:9000;",
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "JX7LA",
              "name": "ce_line13",
              "fill": "#E4E4E7",
              "content": "        fastcgi_index index.php;",
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "IEUrd",
              "name": "ce_line14",
              "fill": "#E4E4E7",
              "content": "        include fastcgi_params;",
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "Dy2A5",
              "name": "ce_line15",
              "fill": "#60A5FA",
              "content": "    }",
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "OyCww",
              "name": "ce_line16",
              "fill": "#F472B6",
              "content": "}",
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "normal"
            }
